# =============================================
# Environment Variables untuk Vercel Deployment
# =============================================
# Salin file ini menjadi .env dan isi nilainya
# JANGAN upload file .env ke GitHub!

# --- PostgreSQL (Prisma Postgres Vercel) ---
DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"

# --- Keamanan JWT ---
JWT_SECRET="inventaris-secret-gedung-agung-2026-aman"

# --- Environment ---
NODE_ENV="production"
