# =============================================
# Environment Variables untuk Vercel Deployment
# =============================================
# Salin file ini menjadi .env dan isi nilainya
# JANGAN upload file .env ke GitHub!

# --- PostgreSQL (Vercel Postgres / Neon / Supabase) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL (untuk migrasi Prisma tanpa pooler)
DIRECT_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# --- Keamanan JWT ---
# Ganti dengan string acak yang panjang dan aman!
JWT_SECRET="ganti-dengan-string-rahasia-yang-panjang-dan-aman-2026"

# --- Environment ---
NODE_ENV="production"
